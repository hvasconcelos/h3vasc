# Umami analytics. Copy to .env and fill in to enable; leave unset and no
# analytics tag is emitted at all.
#
# These are read at BUILD time, not at runtime — Astro inlines PUBLIC_* into
# the static HTML. Set them wherever the build happens: Vercel's environment
# variables, or --build-arg for the Dockerfile.

# From the Umami dashboard: Settings -> Websites -> your site -> Website ID.
PUBLIC_UMAMI_WEBSITE_ID=

# Only needed when self-hosting. Defaults to Umami Cloud.
# PUBLIC_UMAMI_SRC=https://analytics.example.com/script.js

---
/**
 * Background music for the homepage: a looping track behind one play/pause
 * button, with the track credit revealed on hovering or focusing it.
 *
 * Playback is attempted on load and, when the browser refuses it — which is
 * most of the time, autoplay with sound needs a user gesture — retried on the
 * visitor's first interaction. See the script below for the state model; the
 * short version is that "the visitor wants sound" and "the browser is letting
 * us" are separate flags, and conflating them is the bug this design avoids.
 *
 * There is exactly one of these on the page. The script is module-scoped like
 * every script here, and it stamps state on <html>, so a second instance would
 * fight the first over the same attribute.
 */
import { backgroundTrack } from '../data/music'
---

<div data-music-group class="relative flex shrink-0 items-center">
  {/*
    preload="none": the loop is ~0.8 MB and most visitors' browsers will refuse
    the autoplay, so fetching eagerly would spend their bandwidth on audio they
    may never hear. play() starts the fetch itself when it is actually wanted.

    Opus first — it loops gaplessly where MP3 seams audibly on every restart.
    The .ogg container rather than .opus is deliberate: nginx's mime.types maps
    .ogg to audio/ogg and has no .opus entry at all.
  */}
  <audio data-music loop preload="none">
    <source src={backgroundTrack.srcOpus} type="audio/ogg; codecs=opus" />
    <source src={backgroundTrack.src} type="audio/mpeg" />
  </audio>

  {/*
    Labelled "Play" in the served HTML because nothing is playing yet — and
    with JavaScript off, never will be. The script relabels it the moment
    playback actually starts, which is also when the pause icon appears.
  */}
  <button
    id="music-toggle"
    type="button"
    aria-label="Play background music"
    class="shrink-0 rounded border border-gray-200 p-2 text-terminal transition hover:border-gray-400 hover:opacity-80"
  >
    {/*
      Like ThemeToggle's sun/moon, each icon is the *action*, not the state:
      pause shows while playing, play shows while stopped — the media-player
      convention everyone already reads without thinking.
    */}
    <svg
      class="hidden h-4 w-4 sound-on:block"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M15.75 5.25v13.5m-7.5-13.5v13.5"
      />
    </svg>

    {/* Stopped: paused by choice, or the browser has not let us start yet. */}
    <svg
      class="h-4 w-4 sound-on:hidden"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z"
      />
    </svg>
  </button>

  {/*
    Revealed by hovering or focusing the button — its click is already spoken
    for by play/pause, so the credit rides on hover instead of a second
    button.

    Hover alone would strand keyboard and touch users, so `focusin` on the
    wrapper opens it too. That covers both: tabbing to the button reveals the
    panel and the next Tab lands in the Spotify link, and a tap on touch (where
    there is no hover) focuses the button and does the same.

    `hidden` rather than an opacity utility: the attribute takes that link out
    of the tab order while closed, where an invisible-but-focusable link is a
    keyboard trap in miniature. It also means no gap between button and panel —
    `mt-2` is margin on a still-hovered wrapper, not dead space.
  */}
  <div
    id="music-info"
    hidden
    class="absolute top-full right-0 z-10 mt-2 w-64 max-w-[calc(100vw-3rem)] rounded border border-gray-200 bg-gray-50 p-4"
  >
    <p class="font-mono text-xs text-gray-500">now playing</p>
    <p class="mt-1 text-sm text-gray-900">
      {backgroundTrack.artist} — {backgroundTrack.title}
    </p>
    <a
      href={backgroundTrack.url}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-3 inline-block border-b border-gray-300 text-sm text-accent transition-opacity hover:opacity-70"
    >
      Listen on Spotify
    </a>
  </div>
</div>

<style>
  /*
   * The UA sheet's [hidden] { display: none } is only as specific as a class,
   * so it would lose to any display utility that later landed on this element.
   * Stated explicitly so hiding the panel cannot quietly stop working.
   */
  #music-info[hidden] {
    display: none;
  }
</style>

<script>
  const audio = document.querySelector<HTMLAudioElement>('audio[data-music]')
  const toggle = document.getElementById('music-toggle')

  if (audio && toggle) {
    const STORAGE_KEY = 'music'
    const root = document.documentElement

    /**
     * What the visitor asked for. Changed by a click on the toggle and by
     * nothing else — in particular not by the tab being hidden, which is what
     * makes returning to a paused tab leave it paused.
     */
    let intent = localStorage.getItem(STORAGE_KEY) !== 'off'

    /**
     * Whether the browser is actually letting us make noise. This is the
     * autoplay policy's answer, not the visitor's, and it is never persisted:
     * a policy decision on one visit says nothing about the next.
     */
    let unlocked = false

    /** Set while a play() is in flight, so events cannot stack attempts up. */
    let pending = false

    /** Live only while waiting for a gesture to unlock playback. */
    let gestures: AbortController | null = null

    /*
     * The two flags above are the entire state, and everything visible is
     * derived from them here — so there is exactly one definition of "sound is
     * on", and nothing anywhere reads audio.paused to decide what to display.
     */
    const render = () => {
      const on = intent && unlocked
      root.dataset.music = on ? 'on' : 'off'
      toggle.setAttribute(
        'aria-label',
        on ? 'Pause background music' : 'Play background music'
      )
    }

    const disarm = () => {
      gestures?.abort()
      gestures = null
    }

    /**
     * Autoplay was refused, so the visitor's next gesture stands in for the
     * permission. The listeners are dropped only once a play() has actually
     * resolved, never on the first event to arrive — a scroll must not spend
     * the one attempt on browsers that do not accept it as user activation.
     */
    const arm = () => {
      if (gestures) return
      gestures = new AbortController()
      const options = { signal: gestures.signal, passive: true }
      const onGesture = () => {
        if (intent) attemptPlay()
      }
      for (const type of ['pointerdown', 'keydown', 'touchstart', 'scroll']) {
        document.addEventListener(type, onGesture, options)
      }
    }

    /**
     * The only place playback ever starts. Every rejection drops back to "not
     * unlocked" and re-arms, so the button never claims sound the visitor
     * cannot actually hear.
     */
    const attemptPlay = () => {
      if (pending) return
      pending = true
      // Normalises the browsers whose play() returns undefined into the
      // promise path, so there is one code path rather than a branch.
      Promise.resolve(audio.play())
        .then(() => {
          unlocked = true
          disarm()
        })
        .catch(() => {
          unlocked = false
          arm()
        })
        .finally(() => {
          pending = false
          render()
        })
    }

    toggle.addEventListener('click', () => {
      // Keyed off what the button is currently showing, not off intent alone:
      // while autoplay is still blocked the button reads "play" even though
      // intent is already true, and clicking must start the music rather than
      // flip a flag nobody can see.
      if (intent && unlocked) {
        intent = false
        audio.pause()
        // Without this, a later scroll would restart music just turned off.
        disarm()
      } else {
        intent = true
        attemptPlay() // the click itself is the gesture, so this attempt lands
      }
      localStorage.setItem(STORAGE_KEY, intent ? 'on' : 'off')
      render()
    })

    /*
     * A hidden tab gets silence and nothing else. Deliberately no state
     * change: intent belongs to the visitor and unlocked to the browser, and a
     * tab switch is neither one's opinion. Coming back replays only what was
     * already wanted. Calling pause() on an already-paused element is a no-op,
     * which is why this does not inspect audio.paused — inspecting it is the
     * habit that leads to conflating the two concerns in the first place.
     */
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        audio.pause()
        return
      }
      if (intent) attemptPlay()
    })

    /*
     * Anything that pauses us from outside — OS transport keys, a headset
     * button — has to land in the same state a click would, or the button ends
     * up claiming sound that stopped. The tab-hidden pause is excluded: that
     * one is temporary and must not touch intent.
     */
    audio.addEventListener('pause', () => {
      if (document.hidden || !intent || !unlocked) return
      intent = false
      localStorage.setItem(STORAGE_KEY, 'off')
      render()
    })

    render()

    // A tab opened in the background is refused autoplay everywhere, so let
    // the visibilitychange handler above take the first attempt instead of
    // burning one now.
    if (intent && !document.hidden) attemptPlay()
  }

  const panel = document.getElementById('music-info')
  const group = panel?.closest<HTMLElement>('[data-music-group]')

  if (panel && group) {
    /*
     * Hover and focus are tracked separately and the panel closes only when
     * neither holds. Collapsing them into one flag is how these end up
     * flickering: moving the mouse from the button into the panel fires
     * pointerleave on the button, and tabbing into the Spotify link fires
     * focusout on it, and in both cases the panel must stay put.
     */
    const open = () => {
      panel.hidden = false
    }

    /** Closes unless the other of the two reasons to stay open still holds. */
    const close = (focusStaysInside: boolean) => {
      if (focusStaysInside || group.matches(':hover')) return
      panel.hidden = true
    }

    group.addEventListener('pointerenter', open)
    // activeElement is trustworthy here — no focus change is in flight.
    group.addEventListener('pointerleave', () =>
      close(group.contains(document.activeElement))
    )

    // focusin/focusout rather than focus/blur: those do not bubble, and the
    // link inside the panel has to count as "focus is still in here".
    group.addEventListener('focusin', open)
    group.addEventListener('focusout', (event) => {
      // During focusout, activeElement is typically <body> — focus has left
      // but not yet arrived. relatedTarget is where it is going, and is the
      // only reliable answer to "is it still one of ours?".
      const next = event.relatedTarget as Node | null
      close(next !== null && group.contains(next))
    })

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || panel.hidden) return
      panel.hidden = true
    })
  }
</script>

---
// The site is set entirely in JetBrains Mono. Inter is still a dependency but
// is deliberately not imported, so its files never reach the bundle.
import '@fontsource-variable/jetbrains-mono'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  /** Overrides the default social card. Must be a path under public/. */
  image?: string
}

const { title, description, image = '/og.png' } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const socialImage = new URL(image, Astro.site)

// Stable @id for the Person node, referenced from every other node in the
// JSON-LD graph below.
const site = Astro.site?.href
const personId = `${site}#helder-vasconcelos`

// Umami — cookieless analytics, so there is nothing here to put behind a
// consent banner. Both values come from the environment rather than the
// repository, which matters twice over: `npm run dev` reports nothing, and a
// fork that does not set them ships no tracker instead of quietly counting
// its visitors into this site's dashboard.
// `||` rather than `??` on the src: an unset Docker ARG forwarded through ENV
// arrives as an empty string, not as undefined, and `??` would happily use it
// as the script URL.
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID
const umamiSrc =
  import.meta.env.PUBLIC_UMAMI_SRC || 'https://cloud.umami.is/script.js'
---

<!doctype html>
<!-- Dark is the served default, so it holds even with JavaScript disabled. -->
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Helder Vasconcelos" />
    <meta
      name="keywords"
      content="ai, software engineer, llm , agentic, open source"
    />
    <link rel="canonical" href={canonical} />

    {/*
      The whole icon set is cut from public/avatar.jpg by scripts/generate-icons.mjs.
      No SVG icon on purpose: browsers prefer image/svg+xml over everything
      else here, so one would quietly win over the photo.
    */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link
      rel="icon"
      href="/favicon-96x96.png"
      type="image/png"
      sizes="96x96"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    {/*
      The Markdown twin of this page, generated from the same src/data modules.
      Agents that would otherwise strip tags off the HTML can fetch this
      instead; /llms.txt points at it as well.
    */}
    <link
      rel="alternate"
      type="text/markdown"
      href="/index.md"
      title="This page as Markdown"
    />

    {/*
      Runs before first paint so the page never flashes the wrong theme.
      Must stay inline and unbundled — a deferred script would paint first.
    */}
    <script is:inline>
      ;(function () {
        // Dark is the default: the OS preference is deliberately not consulted,
        // so a visitor on a light system still lands on the dark theme. Only an
        // explicit choice from the toggle overrides it.
        var stored = localStorage.getItem('theme')
        document.documentElement.dataset.theme =
          stored === 'light' ? 'light' : 'dark'
      })()
    </script>

    {/*
      is:inline keeps Astro's bundler away from it — this has to stay the exact
      tag Umami serves, loaded from their origin, not something rolled into the
      site's own JS.
    */}
    {
      umamiWebsiteId && (
        <script is:inline defer src={umamiSrc} data-website-id={umamiWebsiteId} />
      )
    }

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Hélder Vasconcelos - Personal Website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Hélder Vasconcelos — Chief Technology Officer at LayerX"
    />
    <meta property="profile:first_name" content="Hélder" />
    <meta property="profile:last_name" content="Vasconcelos" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@heldervasc" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta
      name="twitter:image:alt"
      content="Hélder Vasconcelos — Chief Technology Officer at LayerX"
    />

    {/*
      A @graph rather than a bare Person, so the page, the site and the person
      are separate nodes that reference each other by @id. That is what lets a
      consumer tell "this page is about him" from "he wrote this", instead of
      inferring both from one flat object.
    */}
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'ProfilePage',
            '@id': `${site}#page`,
            url: canonical.href,
            name: title,
            description,
            inLanguage: 'en-GB',
            isPartOf: { '@id': `${site}#website` },
            about: { '@id': personId },
            mainEntity: { '@id': personId },
            primaryImageOfPage: socialImage.href,
          },
          {
            '@type': 'WebSite',
            '@id': `${site}#website`,
            url: site,
            name: 'Hélder Vasconcelos',
            description,
            inLanguage: 'en-GB',
            publisher: { '@id': personId },
          },
          {
            '@type': 'Person',
            '@id': personId,
            name: 'Hélder Vasconcelos',
            alternateName: 'Helder Vasconcelos',
            givenName: 'Hélder',
            familyName: 'Vasconcelos',
            url: site,
            mainEntityOfPage: { '@id': `${site}#page` },
            image: socialImage.href,
            description,
            jobTitle: 'Chief Technology Officer',
            hasOccupation: {
              '@type': 'Occupation',
              name: 'Chief Technology Officer',
              occupationLocation: { '@type': 'City', name: 'Porto' },
            },
            worksFor: {
              '@type': 'Organization',
              name: 'LayerX',
              url: 'https://layerx.xyz',
            },
            alumniOf: {
              '@type': 'CollegeOrUniversity',
              name: 'Universidade de Aveiro',
              url: 'https://www.ua.pt',
            },
            knowsAbout: [
              'Agentic workflows',
              'LLM inference',
              'High performance systems',
              'Real-time trading systems',
              'Distributed systems',
              'Apple Silicon and MLX',
              'Smart contracts and DeFi',
            ],
            knowsLanguage: ['en', 'pt'],
            nationality: { '@type': 'Country', name: 'Portugal' },
            address: {
              '@type': 'PostalAddress',
              addressLocality: 'Porto',
              addressCountry: 'PT',
            },
            sameAs: [
              'https://github.com/hvasconcelos',
              'https://linkedin.com/in/heldervasc',
              'https://x.com/heldervasc',
              'https://taikai.network/heldervasc',
            ],
          },
          {
            '@type': 'Book',
            '@id': `${site}#asynchronous-android-programming`,
            name: 'Asynchronous Android Programming',
            bookEdition: 'Second Edition',
            author: { '@id': personId },
            publisher: { '@type': 'Organization', name: 'Packt Publishing' },
            datePublished: '2016',
            isbn: '9781785880165',
            url: 'https://www.packtpub.com/product/asynchronous-android-programming-second-edition/9781785880165',
          },
        ],
      })}
    />
  </head>
  <body class="font-sans">
    <slot />
  </body>
</html>

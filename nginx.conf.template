# Both maps below are http-context directives. This file is rendered into
# /etc/nginx/conf.d/, which the stock nginx.conf includes inside http {}, so
# they belong here — above the server block, not in it.

# Which representation of the homepage to serve. An agent that asks for
# Markdown gets the twin; everyone else gets the HTML. The regex is unanchored
# and ignores q-values — nginx cannot parse those — so a client that lists
# text/markdown at all is taken to want it. Browsers never do; the Accept
# header Chrome and Safari send has no Markdown in it.
map $http_accept $homepage {
    default            /index.html;
    "~*text/markdown"  /index.md;
}

# Link headers (RFC 8288), so the alternate representation, the sitemap and the
# agent index are all discoverable from a HEAD request. The same three are in
# <head>, but finding them there means fetching and parsing the HTML first.
# Relative references on purpose: they resolve against the request URI, which
# keeps the domain in astro.config.mjs and nowhere else.
map $uri $agent_link {
    default    '';
    ~\.html$   '</index.md>; rel="alternate"; type="text/markdown", </sitemap.xml>; rel="sitemap", </llms.txt>; rel="describedby"';
    /index.md  '</>; rel="alternate"; type="text/html", </sitemap.xml>; rel="sitemap", </llms.txt>; rel="describedby"';
}

server {
    # No IPv6 listener: some container runtimes ship without IPv6 and nginx
    # refuses to start when the address family is missing.
    listen      ${PORT};
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # Don't advertise the nginx version.
    server_tokens off;

    # The content carries accented characters, and text/plain has no in-band
    # way to declare an encoding — without this, /llms.txt and /robots.txt
    # render "Hélder" as mojibake. Applies to the types in charset_types,
    # which covers text/html, text/plain and text/xml.
    charset utf-8;

    # add_header does not merge across levels: a location that declares even
    # one add_header of its own inherits *none* of these. Every location below
    # that sets a header therefore repeats the whole set. Adding a header to a
    # location without repeating them silently drops all four.
    #
    # Link carries an empty value on everything that is not a page, and
    # add_header omits a header whose value is empty, so assets are unaffected.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Link $agent_link always;

    gzip            on;
    gzip_vary       on;
    gzip_min_length 256;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        image/svg+xml;

    # Astro fingerprints everything under /_astro/, so it can be cached forever.
    # nosniff matters most here of anywhere — this is the JavaScript and CSS.
    location /_astro/ {
        access_log off;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Fonts are fingerprinted too, but may be requested from other origins.
    location ~* \.(woff2?|ttf|otf)$ {
        access_log off;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Access-Control-Allow-Origin "*" always;
    }

    # The homepage answers to Accept. `rewrite ... last` rather than try_files:
    # it re-runs location matching, which is what lands the Markdown case in
    # `location = /index.md` below and gets it labelled text/markdown.
    # try_files would serve the file from here instead, and nginx would type it
    # from its own mime.types — which has no .md entry.
    location = / {
        rewrite ^ $homepage last;
    }

    # HTML is revalidated so a redeploy is picked up immediately.
    location = /index.html {
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Link $agent_link always;
        add_header Cache-Control "no-cache" always;
        # This URL has two representations, so a cache must key on Accept.
        add_header Vary "Accept" always;
    }

    # The Markdown twin. nginx's bundled mime.types has no entry for .md, so
    # without this it is served as application/octet-stream and clients
    # download it instead of reading it. The empty types block clears the
    # inherited map for this one location so default_type always wins.
    location = /index.md {
        types { }
        default_type "text/markdown; charset=utf-8";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Link $agent_link always;
        add_header Cache-Control "no-cache" always;
        add_header Vary "Accept" always;
        add_header Access-Control-Allow-Origin "*" always;
    }

    # Same gap as /index.md above: nginx's bundled mime.types has no entry for
    # .webmanifest, and Chrome refuses a manifest served as octet-stream.
    location = /site.webmanifest {
        types { }
        default_type "application/manifest+json";
    }

    # The icon set is regenerated only when the avatar changes, and the names
    # are not fingerprinted, so this is a day rather than a year.
    location ~* ^/(favicon\.ico|favicon-96x96\.png|apple-touch-icon\.png|icon-(192|512)\.png)$ {
        access_log off;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control "public, max-age=86400" always;
    }

    # The background loop is copied verbatim out of public/, so the name is not
    # fingerprinted — a month rather than a year, like the icon set above.
    # mime.types already maps .mp3 to audio/mpeg and .ogg to audio/ogg, so only
    # the caching is missing here. Deliberately absent from gzip_types: both
    # formats are already compressed and re-compressing them only burns CPU.
    location ~* \.(mp3|ogg)$ {
        access_log off;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control "public, max-age=2592000" always;
    }

    location / {
        try_files $uri $uri/ $uri.html =404;
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
}
